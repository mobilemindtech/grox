#!/usr/bin/env bash
# Barra commits com termos privados (nomes de apps, hosts internos...) no repositório público.
# A lista fica fora deste repositório (publicá-la exporia os próprios termos): GROX_PRIVATE_TERMS ou
# ~/.config/grox/termos-privados.txt
# (uma expressão regular estendida por linha; linhas vazias e com # são ignoradas).
# Ativar: git config core.hooksPath .githooks
set -euo pipefail

termos="${GROX_PRIVATE_TERMS:-$HOME/.config/grox/termos-privados.txt}"
if [ ! -f "$termos" ]; then
    echo "pre-commit: lista de termos privados não encontrada ($termos); conferência pulada" >&2
    exit 0
fi
padrao="$(grep -vE '^\s*(#|$)' "$termos" | paste -sd'|' -)"
[ -z "$padrao" ] && exit 0

# só as linhas acrescentadas neste commit
achados="$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -inE "$padrao" || true)"
nomes="$(git diff --cached --name-only | grep -iE "$padrao" || true)"
if [ -n "$achados" ] || [ -n "$nomes" ]; then
    echo "pre-commit: termos privados no commit (ver $termos):" >&2
    [ -n "$nomes" ] && echo "$nomes" | sed 's/^/  arquivo: /' >&2
    [ -n "$achados" ] && echo "$achados" | cut -c1-160 | sed 's/^/  /' >&2
    echo "Use \"app A/B/C\" no texto público; detalhes das apps ficam nos repositórios delas. Para forçar: git commit --no-verify" >&2
    exit 1
fi
